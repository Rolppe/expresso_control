+// CONNECTION ICON WIDGET (Default gray Wi-Fi, red after 20 s timeout)
+// ============================================================================
+
+class ConnectionIcon extends ConsumerStatefulWidget {
+  final Duration timeout;
+  const ConnectionIcon({
+    super.key,
+    this.timeout = const Duration(seconds: 20),
+  });
+
+  @override
+  ConsumerState<ConnectionIcon> createState() => _ConnectionIconState();
+}
+
+class _ConnectionIconState extends ConsumerState<ConnectionIcon> {
+  Timer? _timeoutTimer;
+  bool _timedOut = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _startTimerIfNeeded();
+  }
+
+  @override
+  void dispose() {
+    _timeoutTimer?.cancel();
+    super.dispose();
+  }
+
+  void _startTimerIfNeeded() {
+    final connected = ref.read(bleNotifierProvider);
+    if (!connected) {
+      _timeoutTimer?.cancel();
+      _timedOut = false;
+      _timeoutTimer = Timer(widget.timeout, () {
+        if (mounted && !ref.read(bleNotifierProvider)) {
+          setState(() {
+            _timedOut = true;
+          });
+        }
+      });
+    } else {
+      _timeoutTimer?.cancel();
+      _timedOut = false;
+    }
+  }
+
+  void _onScan() {
+    setState(() {
+      _timedOut = false;
+    });
+    _startTimerIfNeeded();
+    ref.read(bleNotifierProvider.notifier).startScan();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    ref.listen<bool>(bleNotifierProvider, (prev, next) {
+      if (next != prev) {
+        if (next) {
+          _timeoutTimer?.cancel();
+          setState(() {
+            _timedOut = false;
+          });
+        } else {
+          _startTimerIfNeeded();
+        }
+      }
+    });
+
+    final connected = ref.watch(bleNotifierProvider);
+    final wifiActive = ref.watch(
+        linkStatusProvider.select((s) => s.active == LinkKind.wifi));
+
+    final IconData iconData;
+    final Color iconColor;
+    final String tooltip;
+
+    if (connected) {
+      iconData = wifiActive ? Icons.wifi : Icons.bluetooth;
+      iconColor = Colors.green;
+      tooltip = 'Yhdistetty (${wifiActive ? "Wi-Fi" : "Bluetooth"})';
+    } else {
+      iconData = Icons.wifi;
+      iconColor = _timedOut ? Colors.red : Colors.grey;
+      tooltip = _timedOut
+          ? 'Ei yhteyttä — hae napauttamalla'
+          : 'Etsitään yhteyttä...';
+    }
+
+    return IconButton(
+      key: const Key('connection_icon_button'),
+      icon: Icon(
+        iconData,
+        color: iconColor,
+        size: 28,
+      ),
+      tooltip: tooltip,
+      onPressed: _onScan,
+    );
+  }
+}
