+import 'dart:async';
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:silvia_pico_ui/core/providers.dart';
+import 'package:silvia_pico_ui/features/link/link_selector.dart';
+import 'package:silvia_pico_ui/features/link/machine_link.dart';
+import 'package:silvia_pico_ui/features/link/wifi_key_store.dart';
+import 'package:silvia_pico_ui/features/ui/layouts/landscape_layout.dart';
+import 'package:silvia_pico_ui/features/ui/widgets/graph_widget.dart';
+import 'package:silvia_pico_ui/features/ui/widgets/tare_button.dart';
+import 'package:silvia_pico_ui/features/ui/widgets/value_display.dart';
+import 'package:silvia_pico_ui/models/data_point.dart';
+import 'package:silvia_pico_ui/models/machine_status.dart';
+
+class TestLink implements MachineLink {
+  final dataController = StreamController<Map<String, dynamic>>.broadcast();
+  final connectionController = StreamController<bool>.broadcast();
+  final List<String> sent = [];
+  bool connected = false;
+
+  @override
+  Stream<bool> get isConnectedStream => connectionController.stream;
+  @override
+  bool get isConnected => connected;
+  @override
+  Stream<Map<String, dynamic>> get dataStream => dataController.stream;
+  @override
+  Future<void> sendCommand(String command) async {
+    sent.add(command);
+  }
+  @override
+  void requestPendingBrewLog() {}
+  @override
+  Future<void> onAppResumed() async {}
+  @override
+  void onAppPaused() {}
+  @override
+  Future<void> startScan({bool force = false}) async {}
+  @override
+  Future<void> disconnect() async {}
+  @override
+  String deviceSummary() => 'test connected=$connected';
+
+  void setConnected(bool v) {
+    connected = v;
+    connectionController.add(v);
+  }
+}
+
+class TestWifiLink extends TestLink implements WifiLink {
+  @override
+  Future<void> start() async {}
+  @override
+  bool hasKey = true;
+  @override
+  String? bootId = 'b1';
+  @override
+  DateTime? lastPacketAt;
+}
+
+void main() {
+  group('ConnectionIcon widget', () {
+    testWidgets('shows grey wifi icon initially when disconnected, turns red after 20s', (tester) async {
+      final bleLink = TestLink();
+      final wifiLink = TestWifiLink();
+      final keyStore = MemoryWifiKeyStore();
+      final selector = LinkSelector(
+        ble: bleLink,
+        wifi: wifiLink,
+        keyStore: keyStore,
+        mode: LinkMode.auto,
+        wifiEnabled: false,
+        autoKeyRequest: false,
+      );
+
+      await tester.pumpWidget(
+        ProviderScope(
+          overrides: [
+            machineLinkProvider.overrideWithValue(selector),
+          ],
+          child: const MaterialApp(
+            home: Scaffold(
+              body: ConnectionIcon(),
+            ),
+          ),
+        ),
+      );
+      await tester.pump();
+
+      // Initially disconnected: icon is Icons.wifi, color is grey
+      final iconFinder = find.descendant(
+        of: find.byKey(const Key('connection_icon_button')),
+        matching: find.byType(Icon),
+      );
+      expect(iconFinder, findsOneWidget);
+      Icon iconWidget = tester.widget(iconFinder);
+      expect(iconWidget.icon, Icons.wifi);
+      expect(iconWidget.color, Colors.grey);
+
+      // Fast-forward 19 seconds — still grey
+      await tester.pump(const Duration(seconds: 19));
+      iconWidget = tester.widget(iconFinder);
+      expect(iconWidget.color, Colors.grey);
+
+      // Fast-forward 2 more seconds (total 21s) — turns red
+      await tester.pump(const Duration(seconds: 2));
+      iconWidget = tester.widget(iconFinder);
+      expect(iconWidget.icon, Icons.wifi);
+      expect(iconWidget.color, Colors.red);
+
+      // Tapping icon resets timeout back to grey while scanning
+      await tester.tap(find.byKey(const Key('connection_icon_button')));
+      await tester.pump();
+      iconWidget = tester.widget(iconFinder);
+      expect(iconWidget.color, Colors.grey);
+
+      selector.dispose();
+    });
+
+    testWidgets('turns green with Icons.bluetooth when BLE connects, Icons.wifi when Wi-Fi connects', (tester) async {
+      final bleLink = TestLink();
+      final wifiLink = TestWifiLink();
+      final keyStore = MemoryWifiKeyStore();
+      final selector = LinkSelector(
+        ble: bleLink,
+        wifi: wifiLink,
+        keyStore: keyStore,
+        mode: LinkMode.auto,
+        wifiEnabled: true,
+        autoKeyRequest: false,
+      );
+
+      await tester.pumpWidget(
+        ProviderScope(
+          overrides: [
+            machineLinkProvider.overrideWithValue(selector),
+          ],
+          child: const MaterialApp(
+            home: Scaffold(
+              body: ConnectionIcon(),
+            ),
+          ),
+        ),
+      );
+      await tester.pump();
+
+      // Connect via BLE
+      bleLink.setConnected(true);
+      await tester.pumpAndSettle();
+
+      final iconFinder = find.descendant(
+        of: find.byKey(const Key('connection_icon_button')),
+        matching: find.byType(Icon),
+      );
+      Icon iconWidget = tester.widget(iconFinder);
+      expect(iconWidget.icon, Icons.bluetooth);
+      expect(iconWidget.color, Colors.green);
+
+      // Switch to Wi-Fi
+      wifiLink.setConnected(true);
+      selector.setMode(LinkMode.wifi);
+      await tester.pumpAndSettle();
+
+      iconWidget = tester.widget(iconFinder);
+      expect(iconWidget.icon, Icons.wifi);
+      expect(iconWidget.color, Colors.green);
+
+      selector.dispose();
+    });
+  });
+
+  group('ValueDisplay TareButton layout', () {
+    testWidgets('renders TareButton directly below weight value in a right-aligned column', (tester) async {
+      final bleLink = TestLink();
+      final wifiLink = TestWifiLink();
+      final keyStore = MemoryWifiKeyStore();
+      final selector = LinkSelector(
+        ble: bleLink,
+        wifi: wifiLink,
+        keyStore: keyStore,
+        mode: LinkMode.auto,
+        wifiEnabled: false,
+        autoKeyRequest: false,
+      );
+
+      await tester.pumpWidget(
+        ProviderScope(
+          overrides: [
+            machineLinkProvider.overrideWithValue(selector),
+          ],
+          child: const MaterialApp(
+            home: Scaffold(
+              body: SingleChildScrollView(child: ValueDisplay()),
+            ),
+          ),
+        ),
+      );
+      await tester.pumpAndSettle();
+
+      expect(find.text('Weight'), findsOneWidget);
+      expect(find.byType(TareButton), findsOneWidget);
+
+      // Verify Column with crossAxisAlignment: end contains both weight text and TareButton
+      final rightColFinder = find.ancestor(
+        of: find.byType(TareButton),
+        matching: find.byWidgetPredicate(
+          (w) => w is Column && w.crossAxisAlignment == CrossAxisAlignment.end,
+        ),
+      );
+      expect(rightColFinder, findsOneWidget);
+
+      // Weight label is outside that right-aligned column
+      final weightTextFinder = find.text('Weight');
+      expect(
+        find.descendant(of: rightColFinder, matching: weightTextFinder),
+        findsNothing,
+      );
+
+      selector.dispose();
+    });
+  });
+
+  group('LandscapeLayout element reduction & freeze button', () {
+    testWidgets('does not show temperature/pressure numbers or connection/standby icons; shows circular freeze button', (tester) async {
+      tester.view.physicalSize = const Size(852, 393);
+      tester.view.devicePixelRatio = 1.0;
+      addTearDown(tester.view.resetPhysicalSize);
+      addTearDown(tester.view.resetDevicePixelRatio);
+
+      final bleLink = TestLink();
+      final wifiLink = TestWifiLink();
+      final keyStore = MemoryWifiKeyStore();
+      final selector = LinkSelector(
+        ble: bleLink,
+        wifi: wifiLink,
+        keyStore: keyStore,
+        mode: LinkMode.auto,
+        wifiEnabled: false,
+        autoKeyRequest: false,
+      );
+
+      await tester.pumpWidget(
+        ProviderScope(
+          overrides: [
+            machineLinkProvider.overrideWithValue(selector),
+          ],
+          child: const MaterialApp(
+            home: Scaffold(
+              body: LandscapeLayout(),
+            ),
+          ),
+        ),
+      );
+      await tester.pumpAndSettle();
+
+      // Temperature & Pressure number columns must NOT be present
+      expect(find.text('Temperature'), findsNothing);
+      expect(find.text('Pressure (bar)'), findsNothing);
+
+      // Connection and standby icons must NOT be present
+      expect(find.byKey(const Key('connection_icon_button')), findsNothing);
+      expect(find.byIcon(Icons.bedtime_rounded), findsNothing);
+      expect(find.byIcon(Icons.wb_sunny_rounded), findsNothing);
+
+      // Flow, Weight, Pump ratio and Brew Timer are shown
+      expect(find.text('Flow'), findsOneWidget);
+      expect(find.text('Weight'), findsOneWidget);
+      expect(find.text('Pump ratio'), findsOneWidget);
+      expect(find.text('Brew Timer'), findsOneWidget);
+
+      // Freeze button is circular with play/pause icons
+      final freezeBtnFinder = find.byKey(const Key('landscape_freeze_button'));
+      expect(freezeBtnFinder, findsOneWidget);
+
+      // Initially running: pause icon
+      expect(
+        find.descendant(of: freezeBtnFinder, matching: find.byIcon(Icons.pause_rounded)),
+        findsOneWidget,
+      );
+
+      // Tap to freeze/pause
+      await tester.tap(freezeBtnFinder);
+      await tester.pumpAndSettle();
+
+      // Now paused: play icon
+      expect(
+        find.descendant(of: freezeBtnFinder, matching: find.byIcon(Icons.play_arrow_rounded)),
+        findsOneWidget,
+      );
+
+      // Tap to resume/draw
+      await tester.tap(freezeBtnFinder);
+      await tester.pumpAndSettle();
+
+      expect(
+        find.descendant(of: freezeBtnFinder, matching: find.byIcon(Icons.pause_rounded)),
+        findsOneWidget,
+      );
+
+      selector.dispose();
+    });
+  });
+
+  group('Flow plotting in GraphWidget & MachineStatus', () {
+    test('MachineStatus holds flowData and defaults to empty', () {
+      const status = MachineStatus();
+      expect(status.flowData, isEmpty);
+
+      final withFlow = status.copyWith(
+        flowData: [const DataPoint(time: 1.0, value: 2.2)],
+      );
+      expect(withFlow.flowData.length, 1);
+      expect(withFlow.flowData.first.value, 2.2);
+    });
+
+    testWidgets('GraphWidget accepts flowData without errors', (tester) async {
+      await tester.pumpWidget(
+        MaterialApp(
+          home: Scaffold(
+            body: SizedBox(
+              width: 400,
+              height: 200,
+              child: GraphWidget(
+                temperatureData: const [DataPoint(time: 1.0, value: 95.0), DataPoint(time: 2.0, value: 95.2)],
+                pressureData: const [DataPoint(time: 1.0, value: 8.0), DataPoint(time: 2.0, value: 8.1)],
+                flowData: const [DataPoint(time: 1.0, value: 2.0), DataPoint(time: 2.0, value: 2.2)],
+                currentTime: 2.0,
+              ),
+            ),
+          ),
+        ),
+      );
+      await tester.pump();
+      expect(find.byType(GraphWidget), findsOneWidget);
+    });
+  });
+}
